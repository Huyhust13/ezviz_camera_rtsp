[Unit]
Description=Camera livestream web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huy
WorkingDirectory=/home/huy/home-camera/camera
ExecStart=/home/huy/home-camera/camera/venv/bin/python /home/huy/home-camera/camera/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
