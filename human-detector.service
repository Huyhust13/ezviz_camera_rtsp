[Unit]
Description=Motion-gated human detection recorder
After=network-online.target
Wants=network-online.target

[Service]
User=huy
WorkingDirectory=/home/huy/human_detector
# change --source: 0 (USB cam), picam (CSI camera), rtsp://... (IP cam)
ExecStart=/home/huy/human_detector/.venv/bin/python app.py --source 0 --out /home/huy/human_detector/recordings
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
