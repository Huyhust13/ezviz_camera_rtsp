# Main stream: full resolution, ~115% CPU (one core) to software-decode on a Pi 4.
RTSP_URL_MAIN=rtsp://admin:PASSWORD@192.168.10.26:554/H.264
# Sub stream: low-res, ~22% CPU. Used by default — switchable from the web page.
RTSP_URL_SUB=rtsp://admin:PASSWORD@192.168.10.26:554/H.264/ch1/sub
DEFAULT_PROFILE=sub
HOST=0.0.0.0
PORT=8000
